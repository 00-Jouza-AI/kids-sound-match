# Copy this file to .env.local and fill in what you use. .env.local is never committed.

# Optional cloud backup of parents' own packs (see docs/CLOUD-SETUP.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional WhatsApp parents group link (shows "Join Parents Group" on Home).
VITE_PARENTS_GROUP_URL=

# Optional anonymous telemetry endpoint (spec 8.2). Empty = the feature doesn't exist.
VITE_TELEMETRY_URL=
